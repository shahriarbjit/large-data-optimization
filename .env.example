APP_NAME=urban-nest-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- API (config/api.php) ---------------------------------------------------
# Data is always stored and returned in UTC. API_DISPLAY_TIMEZONE is only a
# hint for clients and for human-facing output (reports, emails) later on.
API_VERSION=0.1.0
API_DISPLAY_TIMEZONE=Asia/Dhaka
API_DEFAULT_CURRENCY=BDT

# --- CORS (config/cors.php) -------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------------
# Local: plain text file in storage/logs.
# Non-local (staging, production): JSON lines to stderr. Use:
#   LOG_CHANNEL=stderr
#   LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ------------------------------------------------------------------
# The template does not use a database. Nothing below is read until a module
# adds its first migration. Do not run `php artisan migrate` yet.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# These drivers are chosen so that no request touches the database.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
