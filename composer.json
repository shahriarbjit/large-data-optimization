{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "urban-nest/api",
    "type": "project",
    "description": "Urban Nest API: Laravel modular-monolith API starter template.",
    "keywords": [
        "laravel",
        "api",
        "modular-monolith"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "lint": [
            "pint --test"
        ],
        "lint:fix": [
            "pint"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "deptrac": [
            "deptrac analyse --no-progress"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest"
        ],
        "ci": [
            "@lint",
            "@analyse",
            "@deptrac",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Check code style with Pint (no changes).",
        "lint:fix": "Fix code style with Pint.",
        "analyse": "Static analysis with Larastan.",
        "deptrac": "Check module boundaries with Deptrac.",
        "test": "Run the Pest test suite.",
        "ci": "Run lint, analyse, deptrac and test (same as CI)."
    }
}
